# Address clients use to reach the relay (LAN IP for now, a domain later).
SIDETRAY_HOST=10.1.1.188
# Secret the first device needs to create the server's first group and become its
# Key Master. Generate one with: openssl rand -base64 24. Useless once a group
# exists; later groups use `docker compose exec api sidetray-admin new-group`.
SIDETRAY_SETUP_TOKEN=
# Days to keep events and photos that not every device has fetched yet (default 90).
# Anything every active device has acked is deleted sooner, by the hourly prune job.
SIDETRAY_RETENTION_DAYS=90
# Rate limits (empty = defaults): events/minute and MB of uploads/hour per device,
# join attempts and group-name lookups/hour per client IP.
SIDETRAY_EVENTS_PER_MINUTE=
SIDETRAY_MEDIA_MB_PER_HOUR=
SIDETRAY_JOINS_PER_HOUR=
SIDETRAY_LOOKUPS_PER_HOUR=
