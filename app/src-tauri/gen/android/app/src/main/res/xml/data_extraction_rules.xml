<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Side Tray goes into cloud backups or device-to-device transfers:
     the local archive holds decrypted posts and photos, and the device's keys
     only unwrap with this phone's Keystore anyway (a restored copy can't work). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
