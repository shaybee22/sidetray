{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Side Tray",
  "version": "0.6.0",
  "identifier": "org.sidetray.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Side Tray",
        "width": 900,
        "height": 820,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://media.localhost media:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
